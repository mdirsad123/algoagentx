# =========================================================
# AlgoAgentX Production Docker Environment
# File path: AlgoAgentX/.env.prod
# Used by:
# docker compose --env-file .env.prod up -d --build
# =========================================================

# =========================================================
# App Mode
# =========================================================

ENVIRONMENT=production
APP_ENV=production
ENV=production
DEBUG=false
LOG_LEVEL=INFO

# =========================================================
# Domain / Public URLs
# Replace yourdomain.com with your real domain
# =========================================================

DOMAIN=yourdomain.com

FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
WEB_ORIGIN=https://yourdomain.com

CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_API_SERVER=https://yourdomain.com
NEXT_PUBLIC_UPSTOX_REDIRECT_URI=https://yourdomain.com/api/v1/broker-accounts/upstox/callback

# =========================================================
# Next.js Public Frontend Variables
# These are visible in browser, so only NEXT_PUBLIC values here
# =========================================================

NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_LIVE_KEY_ID

# =========================================================
# PostgreSQL Database
# Docker internal host should be db if docker-compose service is named db
# =========================================================

POSTGRES_DB=algoagentx_prod
POSTGRES_USER=algoagentx_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql+asyncpg://algoagentx_user:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/algoagentx_prod

# =========================================================
# Backend API Server
# =========================================================

API_HOST=0.0.0.0
API_PORT=8000

REQUEST_TIMEOUT_SECONDS=600
BACKTEST_TIMEOUT_SECONDS=600

# =========================================================
# JWT / Auth Security
# Use long random values for JWT secrets
# =========================================================

JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET_KEY
JWT_REFRESH_TOKEN_KEY=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET_KEY
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

# Optional compatibility if your backend reads SECRET_KEY also
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY

# =========================================================
# Admin Security / OTP
# Production should keep ADMIN_OTP_ENABLED=true
# Admin Google login should stay false
# =========================================================

ADMIN_OTP_ENABLED=true
ADMIN_OTP_EXPIRE_MINUTES=10
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_RESEND_COOLDOWN_SECONDS=60

GOOGLE_ADMIN_LOGIN_ENABLED=false

# =========================================================
# Google OAuth
# User Google login only
# Google redirect URI must match Google Cloud Console exactly
# =========================================================

GOOGLE_AUTH_ENABLED=true

GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# Optional compatibility if your app uses these names
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# =========================================================
# Razorpay Production
# Use LIVE keys here, not test keys
# =========================================================

PAYMENT_PROVIDER=razorpay

RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# =========================================================
# SMTP / Email
# Required for admin OTP, forgot password, notifications
# =========================================================

SMTP_ENABLED=true

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587

SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=AlgoAgentX

SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

ADMIN_NOTIFY_EMAILS=admin@yourdomain.com

# =========================================================
# Billing / Currency / Tax
# =========================================================

DEFAULT_CURRENCY=USD

GST_ENABLED=true
GST_PERCENT=18

# Optional if your backend uses INR conversion/tax config
DEFAULT_COUNTRY=IN
TAX_REGION=IN

# =========================================================
# Live Trading / Broker Safety
# =========================================================

LIVE_TRADING_ENABLED=true
PAPER_TRADING_DEFAULT=true
AUTO_TRADE_DEFAULT=false

# Optional broker flags
MT5_ENABLED=true
UPSTOX_ENABLED=true

# =========================================================
# Frontend Runtime / Build
# Used by Next.js build in Docker
# =========================================================

NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# =========================================================
# Python Runtime
# =========================================================

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =========================================================
# Docker / Compose Optional Ports
# Change only if needed
# =========================================================

WEB_PORT=3000
API_PORT_PUBLIC=8000
POSTGRES_PORT_PUBLIC=5432

# =========================================================
# Security Notes
# =========================================================
# Never commit this file to GitHub.
# Keep this file only on your local machine and production VPS.
# Commit only .env.prod.example with placeholder values.
# =========================================================