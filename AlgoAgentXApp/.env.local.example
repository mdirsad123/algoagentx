# AlgoAgentX App environment example
# Copy to .env.local and update values. Do not commit real secrets.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_SERVER=http://localhost:8000

# Long-running API safety fallback (4 hours). Backtests themselves use background jobs,
# so normal multi-year runs are not tied to a single browser request.
NEXT_PUBLIC_API_TIMEOUT_MS=14400000
NEXT_PUBLIC_HEAVY_API_TIMEOUT_MS=14400000
NEXT_PUBLIC_POLLING_API_TIMEOUT_MS=30000
