# AlgoAgentX App - Production Dockerfile
# Place this file at: AlgoAgentXApp/Dockerfile.prod
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app

# NEXT_PUBLIC_* values are baked into the Next.js client at build time.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_SERVER
ARG NEXT_PUBLIC_API_TIMEOUT_MS=600000
ARG NEXT_PUBLIC_HEAVY_API_TIMEOUT_MS=600000
ARG NEXT_PUBLIC_POLLING_API_TIMEOUT_MS=30000
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_UPSTOX_REDIRECT_URI
ARG NEXT_PUBLIC_SECRET_KEY

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_SERVER=$NEXT_PUBLIC_API_SERVER \
    NEXT_PUBLIC_API_TIMEOUT_MS=$NEXT_PUBLIC_API_TIMEOUT_MS \
    NEXT_PUBLIC_HEAVY_API_TIMEOUT_MS=$NEXT_PUBLIC_HEAVY_API_TIMEOUT_MS \
    NEXT_PUBLIC_POLLING_API_TIMEOUT_MS=$NEXT_PUBLIC_POLLING_API_TIMEOUT_MS \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID \
    NEXT_PUBLIC_UPSTOX_REDIRECT_URI=$NEXT_PUBLIC_UPSTOX_REDIRECT_URI \
    NEXT_PUBLIC_SECRET_KEY=$NEXT_PUBLIC_SECRET_KEY \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nextjs && adduser -S nextjs -G nextjs

COPY --from=builder --chown=nextjs:nextjs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nextjs /app/package-lock.json* ./
COPY --from=builder --chown=nextjs:nextjs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nextjs /app/.next ./.next
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/next.config.mjs ./next.config.mjs

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD wget -qO- http://localhost:3000/ >/dev/null 2>&1 || exit 1

CMD ["npm", "run", "start"]
