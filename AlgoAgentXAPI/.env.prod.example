# Database Configuration
DATABASE_URL=your-database-url-here

# JWT Configuration
JWT_SECRET_KEY="your-super-secret-key-change-this-in-production"
JWT_ALGORITHM="HS256"

# Optional: External Auth Service
AUTH_SERVICE_URL=""

# Server Configuration
BASE_URL=your-server-base-url-here

# Cohere API Configuration
COHERE_API_KEY=your-cohere-api-key-here

# Email Configuration
EMAIL_ADDRESS=your-email-address-here
EMAIL_PASSWORD=your-email-password-here

# LinkedIn Configuration
LINKEDIN_EMAIL=your-linkedin-email-here
LINKEDIN_PASSWORD=your-linkedin-password-here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_CONTENT_SID=your-twilio-content-sid-here
TWILIO_FROM_WHATSAPP_NUMBER=your-twilio-from-whatsapp-number-here
TWILIO_TO_WHATSAPP_NUMBER=your-twilio-to-whatsapp-number-here

# Telegram Configuration
TELEGRAM_BOT_NAME=your-telegram-bot-name-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHANNEL_USERNAME=your-telegram-channel-username-here

RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username-here
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_EMAIL=your-smtp-from-email-here
SMTP_FROM_NAME=AlgoAgentX
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Optional legacy/admin list support
SMTP_EMAIL=your-smtp-email-here
ADMIN_NOTIFY_EMAILS=your-admin-notify-emails-here

ENVIRONMENT=development
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_DAYS=30
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_ALLOWED_EMAIL_DOMAIN=
GOOGLE_ADMIN_LOGIN_ENABLED=false
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_MINUTES=30
