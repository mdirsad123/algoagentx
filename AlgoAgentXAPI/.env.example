# AlgoAgentX API environment example
# Copy to .env and update values. Do not commit real secrets.

ENV=development

# Logging
# Keep normal API/worker traffic quiet. Temporarily switch to DEBUG when diagnosing.
LOG_LEVEL=ERROR
ACTIVITY_LOGS=true
ACTIVITY_REQUEST_TTL_SECONDS=60
ACTIVITY_REQUEST_MIN_GAP_SECONDS=2
BACKTEST_HEARTBEAT_LOG_SECONDS=60
CELERY_LOG_LEVEL=error
GUNICORN_LOG_LEVEL=error
DATABASE_URL=postgresql+asyncpg://algo_user:algo_password@localhost:5432/algo_db
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Public API origin used for OAuth redirect URLs.
# DEV:
API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
BROKER_REDIRECT_BASE_URL=http://localhost:8000

# PROD example:
# API_BASE_URL=https://api.yourdomain.com
# PUBLIC_API_BASE_URL=https://api.yourdomain.com
# BROKER_REDIRECT_BASE_URL=https://api.yourdomain.com

# Upstox OAuth. Optional UPSTOX_REDIRECT_URI overrides generated callback URI.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Security
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET_KEY
JWT_REFRESH_TOKEN_KEY=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET_KEY
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256

# Email / SMTP
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlgoAgentX
SMTP_USE_TLS=true
SMTP_USE_SSL=false

API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
BROKER_REDIRECT_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
MT5_EXECUTION_MODE=AGENT
MT5_AGENT_HEARTBEAT_STALE_SECONDS=90
LIVE_RUNNER_ENABLED=true
LIVE_RUNNER_INTERVAL_SECONDS=1
LIVE_BROKER_SYNC_ENABLED=true
LIVE_BROKER_SYNC_LOOP_SECONDS=5
# AlgoAgentX Real-Time Alerting Phase 1
# Create a bot with BotFather; never commit the real token.
TELEGRAM_BOT_TOKEN=
# Optional owner/admin fallback. Users can save their own chat ID from the Alerts page.
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# Optional Twilio WhatsApp channel. User-specific destination numbers can be saved from the Alerts UI.
# Use E.164 numbers, for example +919876543210. The service automatically adds the whatsapp: prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP_NUMBER=
# Optional owner/admin fallback destination when a user has not saved a WhatsApp number.
TWILIO_TO_WHATSAPP_NUMBER=
# Legacy single approved Twilio Content Template SID (backwards compatibility only).
# If the dedicated SIDs below are blank, this SID is used with legacy variables:
# 1=symbol, 2=condition, 3=target/zone, 4=current price.
TWILIO_CONTENT_SID=

# Recommended dedicated WhatsApp Content Template SIDs.
# APPROACHING template variables:
# 1=symbol, 2=status, 3=level/zone, 4=current price, 5=distance, 6=direction, 7=triggered IST time, 8=alert ID
TWILIO_CONTENT_SID_APPROACHING=
# TRIGGERED template variables:
# 1=symbol, 2=status, 3=level/zone, 4=current price, 5=triggered IST time, 6=alert ID
TWILIO_CONTENT_SID_TRIGGERED=

# If no template SID is configured, the sender uses a normal Body message (subject to Twilio/WhatsApp session rules).
TWILIO_TIMEOUT_SECONDS=10

ALERT_WORKER_HEARTBEAT_TTL_SECONDS=30
ALERT_FEED_STALE_SECONDS=15
ALERT_QUOTE_POLL_INTERVAL_MS=250
